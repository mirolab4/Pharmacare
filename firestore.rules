rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isMember(pid) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/pharmacies/$(pid)/members/$(request.auth.uid));
    }
    match /pharmacies/{pid} {
      allow create: if request.auth != null
        && request.resource.data.joinCode is string
        && request.resource.data.joinCode.size() >= 8;
      allow read, update: if isMember(pid);
      match /members/{uid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == uid
          && request.resource.data.joinCode ==
             get(/databases/$(database)/documents/pharmacies/$(pid)).data.joinCode;
      }
      match /{col}/{docId} {
        allow read, write: if col != 'members' && isMember(pid);
      }
    }
  }
}
