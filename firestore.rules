rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isPharmacyUser() {
      // Allow pharmacy operations without forcing manual login for cashier/POS
      return true;
    }

    // Products
    match /products/{productId} {
      allow read: if true;
      allow write: if isPharmacyUser() && isValidId(productId);
    }

    // Categories
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isPharmacyUser() && isValidId(categoryId);
    }

    // Manufacturers
    match /manufacturers/{manufacturerId} {
      allow read: if true;
      allow write: if isPharmacyUser() && isValidId(manufacturerId);
    }

    // Ingredients
    match /ingredients/{ingredientId} {
      allow read: if true;
      allow write: if isPharmacyUser() && isValidId(ingredientId);
    }

    // Customers
    match /customers/{customerId} {
      allow read: if isPharmacyUser();
      allow write: if isPharmacyUser() && isValidId(customerId);
    }

    // Suppliers
    match /suppliers/{supplierId} {
      allow read: if isPharmacyUser();
      allow write: if isPharmacyUser() && isValidId(supplierId);
    }

    // Invoices
    match /invoices/{invoiceId} {
      allow read: if isPharmacyUser();
      allow create, update: if isPharmacyUser() && isValidId(invoiceId);
      allow delete: if isPharmacyUser() && isValidId(invoiceId);
    }

    // Purchases
    match /purchases/{purchaseId} {
      allow read: if isPharmacyUser();
      allow write: if isPharmacyUser() && isValidId(purchaseId);
    }

    // Vouchers
    match /vouchers/{voucherId} {
      allow read: if isPharmacyUser();
      allow write: if isPharmacyUser() && isValidId(voucherId);
    }

    // Banks
    match /banks/{bankId} {
      allow read: if isPharmacyUser();
      allow write: if isPharmacyUser() && isValidId(bankId);
    }

    // Stock Movements
    match /stockMovements/{movementId} {
      allow read: if isPharmacyUser();
      allow create: if isPharmacyUser() && isValidId(movementId);
    }

    // Settings
    match /settings/{settingsId} {
      allow read: if true;
      allow write: if isPharmacyUser() && isValidId(settingsId);
    }
  }
}
