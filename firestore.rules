rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // يسمح بالقراءة والكتابة لأي مستخدم مسجل (بما في ذلك الحساب المجهول Anonymous)
    // داخل مساحات العمل والصيدليات وجميع المستندات التابعة لها
    match /workspaces/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /pharmacies/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /test/{document=**} {
      allow read, write: if request.auth != null;
    }
    // كقاعدة عامة لحماية أي مسار آخر
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}

