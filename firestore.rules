rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /workspaces/{wid}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    match /pharmacies/{pid}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
